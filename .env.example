AWS_ENDPOINT_URL=http://localhost:4566
# Only needed when the caller reaches AWS at a different address than the app
# does (see docker-compose.yml's app service). Leave unset for `make run`.
# PUBLIC_AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
APP_ENV=dev
DEBUG_ROUTES=true
